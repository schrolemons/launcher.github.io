# Server/CI only. Never use PUBLIC_ prefixes or commit actual credentials.
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
UPSTASH_VECTOR_NAMESPACE=launcher-v2
# Only set after checking the existing index's embedding configuration.
VECTOR_EMBEDDING_MODE=external
# Fill any model identifier accepted by your embedding endpoint.
VECTOR_EMBEDDING_MODEL=
VECTOR_EMBEDDING_DIMENSION=
VECTOR_EMBEDDING_URL=https://api.openai.com/v1/embeddings
VECTOR_EMBEDDING_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DEEPSEEK_API_KEY=
# Comma-separated exact origins of this launcher (add preview domains explicitly).
CHAT_ALLOWED_ORIGINS=https://sch-nie.com,https://www.sch-nie.com,https://ark.sch-nie.com,https://blog.sch-nie.com,https://world.sch-nie.com,https://zero.sch-nie.com
CHAT_DAILY_REQUESTS=300
# Conservative reserved token budget, not actual billed token count.
CHAT_DAILY_TOKEN_BUDGET=3000000
CHAT_MIN_SCORE=0.45
