# Never expose server secrets through PUBLIC_ variables or commit actual credentials.
# The Turnstile site key below is intentionally public; its secret key is not.
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
UPSTASH_VECTOR_NAMESPACE=launcher-v2
# Only set after checking the existing index's embedding configuration.
VECTOR_EMBEDDING_MODE=upstash-data
# For external mode only: fill any model identifier accepted by your endpoint.
VECTOR_EMBEDDING_MODEL=
VECTOR_EMBEDDING_DIMENSION=
VECTOR_EMBEDDING_URL=https://api.openai.com/v1/embeddings
VECTOR_EMBEDDING_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DEEPSEEK_API_KEY=
# Exact comma-separated hostnames accepted for visitor-supplied OpenAI-compatible endpoints.
# api.deepseek.com is always allowed.
CHAT_ALLOWED_MODEL_HOSTS=
# Optional as a pair. When the server secret is present, every chat request must pass Turnstile.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Random server-only secret with at least 32 characters, used to sign anonymous session cookies.
CHAT_SESSION_SECRET=
# Comma-separated exact origins of this launcher (add preview domains explicitly).
CHAT_ALLOWED_ORIGINS=https://sch-nie.com,https://www.sch-nie.com,https://ark.sch-nie.com,https://blog.sch-nie.com,https://world.sch-nie.com,https://zero.sch-nie.com
CHAT_DAILY_REQUESTS=300
# Conservative reserved token budget, not actual billed token count.
CHAT_DAILY_TOKEN_BUDGET=3000000
CHAT_MIN_SCORE=0.45
