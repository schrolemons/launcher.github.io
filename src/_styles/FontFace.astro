---
// ----------
// 字体来源：https://web.hycdn.cn/arknights/official/_next/static/css/28ff681e70564115.css
// ----------
---

<style lang="scss" is:global>
  /* 和 astro.config.mjs 中的 base 值一样，默认为 `/` */
  $base: "/";

  @font-face {
    font-family: Bender-Regular;
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: local("Bender-Regular"),
      url("#{$base}fonts/Bender-Regular.woff2") format("woff2"),
      url("#{$base}fonts/Bender-Regular.woff") format("woff"),
      url("#{$base}/fonts/Bender-Regular.ttf") format("truetype"),
      url("#{$base}/fonts/Bender-Regular.eot") format("embedded-opentype")
  }

  @font-face {
    font-family: Bender-Bold;
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: local("Bender-Bold"),
      url("#{$base}fonts/Bender-Bold.woff2") format("woff2"),
      url("#{$base}fonts/Bender-Bold.woff") format("woff"),
      url("#{$base}fonts/Bender-Bold.ttf") format("truetype"),
      url("#{$base}fonts/Bender-Bold.eot") format("embedded-opentype")
  }
</style>
